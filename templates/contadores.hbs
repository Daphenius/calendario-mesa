<div class="cm-raiz cm-editor cm-tema-{{tema}}">
  {{#if gm}}
  <div class="cm-ed-cals-linha">
    <button type="button" data-action="novo"><i class="fa-solid fa-plus"></i> Novo contador</button>
    <button type="button" data-action="limpar"><i class="fa-solid fa-broom"></i> Tirar os terminados</button>
  </div>
  {{/if}}
  {{#if itens.length}}
  <ul class="cm-conts">
    {{#each itens}}
    <li class="cm-cont {{#if feito}}cm-feito{{/if}}">
      <div class="cm-cont-topo"><b>{{nome}}</b>{{#unless visivel}} <i class="fa-solid fa-eye-slash" data-tooltip="Só o mestre vê"></i>{{/unless}}
        <span>{{estado}}</span></div>
      <div class="cm-barra"><span style="width:{{pct}}%"></span></div>
      <small>termina em {{termina}}</small>
      {{#if @root.gm}}
      <span class="cm-cont-acoes">
        <a data-action="somar" data-id="{{id}}" data-s="{{@root.segHora}}" data-tooltip="+1 hora">+1h</a>
        <a data-action="somar" data-id="{{id}}" data-s="{{@root.segDia}}" data-tooltip="+1 dia">+1d</a>
        <a data-action="apagar" data-id="{{id}}" data-tooltip="Apagar"><i class="fa-solid fa-trash"></i></a>
      </span>
      {{/if}}
    </li>
    {{/each}}
  </ul>
  {{else}}
  <p class="cm-vazio">Nenhum contador. Ex.: "O ritual se completa", "Efeito da poção", "Veneno age".</p>
  {{/if}}
</div>
